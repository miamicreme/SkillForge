{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miamicreme/SkillForge/contracts/quality-gate.schema.json",
  "title": "SkillForge Quality Gate",
  "description": "Shared quality gate contract for determining whether an artifact is ready to use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "notes",
    "checks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "notes"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pass", "warn", "fail"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

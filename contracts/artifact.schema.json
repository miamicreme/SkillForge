{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miamicreme/SkillForge/contracts/artifact.schema.json",
  "title": "SkillForge Artifact",
  "description": "Shared artifact contract for SkillForge, SignalBrief, FrameBrief, DealFlow, and EmpireOS adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_contract_version",
    "artifact_type",
    "source_module",
    "title",
    "summary",
    "decision_supported",
    "evidence",
    "risks",
    "next_actions",
    "quality_gate",
    "render_targets"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "default": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "repo_audit",
        "signal_brief",
        "frame_brief",
        "proposal",
        "mvp_plan",
        "business_ops_assessment",
        "deal_brief",
        "branch_plan",
        "implementation_handoff",
        "client_discovery_summary"
      ]
    },
    "source_module": {
      "type": "string",
      "enum": [
        "skillforge",
        "signalbrief",
        "framebrief",
        "dealflow",
        "empireos",
        "manual"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "decision_supported": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./evidence.schema.json"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_gate": {
      "$ref": "./quality-gate.schema.json"
    },
    "render_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "markdown",
          "html",
          "proposal",
          "report",
          "empireos",
          "dealflow",
          "task_list",
          "branch_plan"
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
